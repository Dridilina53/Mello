<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvRetour"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:text="‹ Retour"
        android:textColor="@color/marron"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Mes demandes"
        android:textColor="@color/texte"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Acceptez ou supprimez les demandes de vos clients."
        android:textColor="@color/texte_secondaire"
        android:textSize="16sp" />

    <!-- Message affiché quand il n'y a aucune demande -->
    <TextView
        android:id="@+id/tvVide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="Aucune demande pour le moment."
        android:textColor="@color/texte_secondaire"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- La liste de cartes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDemandes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:clipToPadding="false" />
</LinearLayout>