<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvCoachClient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#7D5A44"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvTitreClient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#4A342A"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvSpecialiteClient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#7D5A44"
        android:textSize="15sp"/>

    <TextView
        android:id="@+id/tvDescriptionClient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#4A342A"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/tvDateClient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#4A342A"/>

    <TextView
        android:id="@+id/tvHeureClient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#4A342A"/>

    <TextView
        android:id="@+id/tvPrixClient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#7D5A44"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/btnDemandeClient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#7D5A44"
        android:text="Envoyer une demande"
        android:textColor="#FFFFFF"/>

</LinearLayout>
