<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Bouton retour -->
    <TextView
        android:id="@+id/tvRetour"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:text="‹ Retour"
        android:textColor="@color/marron"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Titre -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Gérer mes séances"
        android:textColor="@color/texte"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Créez les séances que les clients pourront réserver."
        android:textColor="@color/texte_secondaire"
        android:textSize="16sp" />

    <!-- Zone du milieu : soit le message "aucune séance", soit la liste de cartes -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvVide"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Vous n'avez pas encore créé de séance."
            android:textColor="@color/texte_secondaire"
            android:textSize="16sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSeances"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Bouton créer -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreerSeance"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/marron"
        android:text="+ Créer une séance"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="16dp" />
</LinearLayout>