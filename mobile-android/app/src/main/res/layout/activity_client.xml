<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F1EA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="mello"
            android:textColor="#4A342A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Espace client"
            android:textColor="#7D5A44"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Les séances disponibles"
            android:textColor="#4A342A"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Découvrez les séances proposées par nos coachs."
            android:textColor="#7D5A44"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtRecherche"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="25dp"
            android:background="#FFFFFF"
            android:hint="Rechercher un coach..."
            android:padding="10dp"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvNomCoach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sarah Martin"
                android:textColor="#4A342A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSpecialite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Gestion du stress"
                android:textColor="#7D5A44"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Date : 20 Novembre 2026"
                android:textColor="#4A342A"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvHeure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Heure : 10:00"
                android:textColor="#4A342A"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDuree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Durée : 60 min"
                android:textColor="#4A342A"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvPrix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="45 DT"
                android:textColor="#7D5A44"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnReserver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:backgroundTint="#7D5A44"
                android:text="Réserver"
                android:textColor="#FFFFFF" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
